{
  "openapi": "3.2.0",
  "info": {
    "title": "Sofa.AppGateway | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "Sofa.AppGateway"
        ],
        "summary": "Whether the App Gateway is up.",
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/github-app": {
      "get": {
        "tags": [
          "Sofa.AppGateway"
        ],
        "summary": "Whether Sofa's GitHub App has been created, and where to install it.",
        "operationId": "GetGitHubApp",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitHubAppStatus"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/github-app/creations": {
      "post": {
        "tags": [
          "GitHubAppEndpoints"
        ],
        "summary": "The form that sends the GitHub App's manifest to GitHub, to create the App there.",
        "operationId": "StartGitHubAppCreation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewGitHubApp"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitHubAppCreationForm"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/connections": {
      "get": {
        "tags": [
          "Sofa.AppGateway"
        ],
        "summary": "The Workspace's Connections to outside systems.",
        "operationId": "GetConnections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConnectionSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConnectionSummary": {
        "required": [
          "id",
          "system",
          "account",
          "accountType",
          "addedAt",
          "suspended"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "system": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "accountType": {
            "type": "string"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "suspended": {
            "type": "boolean"
          }
        }
      },
      "GitHubAppCreationForm": {
        "required": [
          "formAction",
          "manifest"
        ],
        "type": "object",
        "properties": {
          "formAction": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          }
        }
      },
      "GitHubAppStatus": {
        "required": [
          "created",
          "name",
          "htmlUrl",
          "installUrl",
          "publicAddress",
          "gitHubCanReachPublicAddress"
        ],
        "type": "object",
        "properties": {
          "created": {
            "type": "boolean"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "htmlUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "installUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "publicAddress": {
            "type": "string"
          },
          "gitHubCanReachPublicAddress": {
            "type": "boolean"
          }
        }
      },
      "NewGitHubApp": {
        "required": [
          "organisation",
          "name"
        ],
        "type": "object",
        "properties": {
          "organisation": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Status": {
        "required": [
          "name",
          "environment",
          "time"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "GitHubAppEndpoints"
    },
    {
      "name": "Sofa.AppGateway"
    }
  ]
}