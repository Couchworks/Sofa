{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "github-webhooks": {
        "ClusterId": "connections",
        "Match": { "Path": "/webhooks/github", "Methods": [ "POST" ] }
      }
    },
    "Clusters": {
      "connections": {
        "Destinations": {
          "connections": { "Address": "http://connections" }
        }
      }
    }
  }
}
